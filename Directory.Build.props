<Project>
  <!--
    集中式构建输出：所有子项目的 bin/obj 统一落到仓库根的 output\ 目录，
    项目根下不再散落 bin/、obj/。清理只需删除 output\ 一个文件夹。

    注意用 $(MSBuildThisFileDirectory) 指回本 props 文件所在目录（仓库根），
    而不是 $(MSBuildThisDirectory)（那是各项目自己的目录）。
    -->
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory)output\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)output\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <!-- 发布版本。窗口标题、exe 文件属性、使用说明都从这里来。 -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>离线翻译助手</Product>
    <Company>WISDRI</Company>
    <AssemblyTitle>离线翻译助手</AssemblyTitle>
    <Description>离线翻译助手</Description>
  </PropertyGroup>
</Project>
