<Window x:Class="OfflineTranslator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="离线翻译助手"
        Icon="app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window.Background}"
        Foreground="{StaticResource Brush.Text.Primary}"
        FontSize="{StaticResource FontSize.Body}"
        FontFamily="{StaticResource Font.Family.Primary}"
        Height="820" Width="1060"
        MinHeight="680" MinWidth="900"
        Closing="Window_Closing">

    <Grid Margin="{StaticResource Layout.WindowPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================= 1. 模型与引擎管理 ======================= -->
        <GroupBox Grid.Row="0" Header="翻译模型与计算引擎（models 目录 · 本地离线）" Margin="0,0,0,8">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="模型选择：" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ModelCombo" Height="30" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="选定模型后点「加载模型」。加载后下拉选择其它模型再点「切换到此模型」可热重载。" />
                <Button Grid.Row="0" Grid.Column="2" x:Name="RefreshModelsButton" Content="刷新" Width="72" Height="30" Margin="0,0,8,0" Click="RefreshModelsButton_Click" ToolTip="重新扫描 models 目录下的所有 GGUF 模型" />
                <Button Grid.Row="0" Grid.Column="3" x:Name="LoadModelButton" Content="加载模型" Style="{StaticResource Button.Secondary}" Width="96" Height="30" Margin="0,0,8,0" Click="LoadModelButton_Click" />
                <Button Grid.Row="0" Grid.Column="4" x:Name="UnloadModelButton" Content="卸载模型" Style="{StaticResource Button.Secondary}" Width="88" Height="30" IsEnabled="False" Click="UnloadModelButton_Click" />

                <!-- 运行状态指标栏 -->
                <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,8,0,0" VerticalAlignment="Center">
                    <TextBlock Text="推理线程：" VerticalAlignment="Center" />
                    <TextBox x:Name="ThreadsBox" Text="0" Width="44" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,16,0" ToolTip="0 = 自动根据 CPU 性能核优化分配。填具体正整数则固定线程数。" />

                    <TextBlock Text="模型：" VerticalAlignment="Center" />
                    <TextBlock x:Name="SelectedModelText" Text="--" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" Margin="4,0,16,0" />

                    <TextBlock Text="状态：" VerticalAlignment="Center" />
                    <TextBlock x:Name="ModelStatusText" Text="未加载" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Disabled}" Margin="4,0,16,0" />

                    <TextBlock Text="后端：" VerticalAlignment="Center" />
                    <TextBlock x:Name="BackendStatusText" Text="--" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" Margin="4,0,16,0" ToolTip="当前实际工作的推理后端（如 Vulkan GPU 加速、CPU 等）" />

                    <TextBlock Text="内存：" VerticalAlignment="Center" />
                    <TextBlock x:Name="MemoryText" Text="--" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" Margin="4,0,0,0" />
                </WrapPanel>
            </Grid>
        </GroupBox>

        <!-- ======================= 2. 本地 OpenAI 兼容 API ======================= -->
        <GroupBox Grid.Row="1" Header="OpenAI 兼容 API（本地 HTTP 接口 · 监听 127.0.0.1）" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="4">
                <TextBlock Text="端口：" VerticalAlignment="Center" />
                <TextBox x:Name="PortBox" Text="21894" Width="72" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="6,0,12,0" />
                <Button x:Name="StartApiButton" Content="启动 API" Style="{StaticResource Button.Secondary}" Width="84" Height="30" Margin="0,0,8,0" IsEnabled="False" Click="StartApiButton_Click" />
                <Button x:Name="StopApiButton" Content="停止 API" Style="{StaticResource Button.Secondary}" Width="84" Height="30" IsEnabled="False" Click="StopApiButton_Click" />
                <TextBlock Text="状态：" VerticalAlignment="Center" Margin="12,0,4,0" />
                <TextBlock x:Name="ApiStatusText" Text="未运行" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Disabled}" Margin="0,0,16,0" />
                <Button x:Name="CopyApiUrlButton" Content="复制地址" Style="{StaticResource Button.Secondary}" Width="80" Height="30" Margin="0,0,8,0" IsEnabled="False" Click="CopyApiUrlButton_Click" />
                <Button x:Name="TestApiButton" Content="测试 API" Style="{StaticResource Button.Secondary}" Width="80" Height="30" IsEnabled="False" Click="TestApiButton_Click" ToolTip="向 /health 和 /v1/chat/completions 发送真实请求测试服务连通性" />
            </StackPanel>
        </GroupBox>

        <!-- ======================= 3. 多语言翻译工作台 ======================= -->
        <GroupBox Grid.Row="2" Header="翻译工作台" Margin="0,0,0,8">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 语言选择与对调控制条 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="源语言：" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Grid.Column="1" x:Name="SourceLangCombo" Width="170" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0" />

                    <Button Grid.Column="2" x:Name="SwapLangButton" Content="⇄ 切换" Style="{StaticResource Button.Secondary}" Width="68" Height="30" Margin="0,0,12,0" Click="SwapLangButton_Click" ToolTip="对调源语言与目标语言，同时互换输入输出文字" />

                    <TextBlock Grid.Column="3" Text="目标语言：" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Grid.Column="4" x:Name="TargetLangCombo" Width="170" Height="30" VerticalContentAlignment="Center" Margin="0,0,12,0" />

                    <TextBlock Grid.Column="5" x:Name="DetectedLangText" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brush.Accent}" FontWeight="SemiBold" />
                </Grid>

                <!-- 原文输入框 -->
                <TextBox Grid.Row="1" x:Name="InputBox"
                         Style="{StaticResource TextBox.Multiline}"
                         AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         MinHeight="100"
                         Padding="8"
                         KeyDown="InputBox_KeyDown"
                         ToolTip="在此输入待翻译原文（支持单行、多行段落，按 Ctrl + Enter 快速翻译）" />

                <!-- 操作工具条（R8: 唯一一个 Primary 按钮为执行翻译） -->
                <Grid Grid.Row="2" Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="TranslateButton" Content="执行翻译 (Ctrl+Enter)"
                            Style="{StaticResource Button.Primary}"
                            Width="180" Height="32" Margin="0,0,8,0"
                            IsEnabled="False" Click="TranslateButton_Click" />

                    <Button Grid.Column="1" x:Name="CancelTranslateButton" Content="停止"
                            Style="{StaticResource Button.Danger}"
                            Width="72" Height="32" Margin="0,0,8,0"
                            IsEnabled="False" Click="CancelTranslateButton_Click" ToolTip="中断当前正在进行的流式推理" />

                    <Button Grid.Column="2" x:Name="ClearButton" Content="清空"
                            Style="{StaticResource Button.Secondary}"
                            Width="72" Height="32" Margin="0,0,8,0"
                            Click="ClearButton_Click" />

                    <Button Grid.Column="3" x:Name="CopyOutputButton" Content="复制译文"
                            Style="{StaticResource Button.Secondary}"
                            Width="92" Height="32" Margin="0,0,16,0"
                            Click="CopyOutputButton_Click" />

                    <TextBlock Grid.Column="4" x:Name="LatencyText" Text="耗时: -- ms"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.Text.Secondary}" FontWeight="SemiBold" />
                </Grid>

                <!-- 译文输出框 -->
                <TextBox Grid.Row="3" x:Name="OutputBox"
                         Style="{StaticResource TextBox.Multiline}"
                         IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         MinHeight="100"
                         Padding="8"
                         Background="{StaticResource Brush.SurfaceAlt}" />
            </Grid>
        </GroupBox>

        <!-- ======================= 4. 运行日志面板 ======================= -->
        <GroupBox Grid.Row="3" Header="运行日志" Padding="4" Height="140">
            <TextBox x:Name="LogBox"
                     Style="{StaticResource TextBox.Code}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </GroupBox>
    </Grid>
</Window>
