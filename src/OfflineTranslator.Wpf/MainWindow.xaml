<Window x:Class="OfflineTranslator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="离线翻译助手"
        Icon="app.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
        FontSize="13"
        Height="800" Width="1020"
        MinHeight="660" MinWidth="880"
        Closing="Window_Closing">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================= 模型管理 ======================= -->
        <GroupBox Grid.Row="0" Header="翻译引擎（models 目录下的 GGUF · 完全离线）" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="模型：" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ModelCombo" Margin="0,0,8,0" Height="28" VerticalContentAlignment="Center" ToolTip="选定模型后点「加载模型」。加载状态下选择其它模型再点一次即可切换。" />
                <Button Grid.Row="0" Grid.Column="2" x:Name="RefreshModelsButton" Content="刷新" Width="68" Height="28" Margin="0,0,8,0" Click="RefreshModelsButton_Click" />
                <Button Grid.Row="0" Grid.Column="3" x:Name="LoadModelButton" Content="加载模型" Width="88" Height="28" Margin="0,0,8,0" Click="LoadModelButton_Click" />
                <Button Grid.Row="0" Grid.Column="4" x:Name="UnloadModelButton" Content="卸载模型" Width="88" Height="28" IsEnabled="False" Click="UnloadModelButton_Click" />

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="推理线程：" VerticalAlignment="Center" />
                    <TextBox x:Name="ThreadsBox" Text="0" Width="48" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip="0 = 自动使用物理性能核。填具体数字则固定线程数。" />
                    <TextBlock Text="    模型：" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <TextBlock x:Name="SelectedModelText" Text="--" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#0066CC" />
                    <TextBlock Text="    状态：" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <TextBlock x:Name="ModelStatusText" Text="未加载" VerticalAlignment="Center" Foreground="Gray" FontWeight="Bold" />
                    <TextBlock Text="    后端：" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <TextBlock x:Name="BackendStatusText" Text="--" VerticalAlignment="Center" Foreground="#007ACC" FontWeight="SemiBold" ToolTip="实际运行的引擎与计算硬件（Vulkan GPU 或 CPU）" />
                    <TextBlock Text="    内存：" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <TextBlock x:Name="MemoryText" Text="--" VerticalAlignment="Center" Foreground="Gray" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ======================= API 服务 ======================= -->
        <GroupBox Grid.Row="1" Header="OpenAI 兼容 API（本地服务 · 监听 127.0.0.1）" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="端口：" VerticalAlignment="Center" />
                <TextBox x:Name="PortBox" Text="21894" Width="72" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                <Button x:Name="StartApiButton" Content="启动 API" Width="88" Height="26" Margin="12,0,8,0" IsEnabled="False" Click="StartApiButton_Click" />
                <Button x:Name="StopApiButton" Content="停止 API" Width="88" Height="26" IsEnabled="False" Click="StopApiButton_Click" />
                <TextBlock Text="    状态：" VerticalAlignment="Center" Margin="16,0,0,0" />
                <TextBlock x:Name="ApiStatusText" Text="未运行" VerticalAlignment="Center" Foreground="Gray" FontWeight="Bold" />
                <Button x:Name="CopyApiUrlButton" Content="复制地址" Width="76" Height="26" Margin="12,0,0,0" IsEnabled="False" Click="CopyApiUrlButton_Click" />
                <Button x:Name="TestApiButton" Content="测试 API" Width="76" Height="26" Margin="8,0,0,0" IsEnabled="False" Click="TestApiButton_Click" ToolTip="向 /health 和 /v1/chat/completions 发一次真实请求，验证服务可用" />
            </StackPanel>
        </GroupBox>

        <!-- ======================= 多语言翻译面板 ======================= -->
        <GroupBox Grid.Row="2" Header="翻译" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="源语言：" VerticalAlignment="Center" />
                    <ComboBox x:Name="SourceLangCombo" Width="170" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,0" />
                    <Button x:Name="SwapLangButton" Content="⇄ 切换" Width="68" Height="28" Margin="0,0,10,0" Click="SwapLangButton_Click" ToolTip="互换源语言和目标语言" />
                    <TextBlock Text="目标语言：" VerticalAlignment="Center" />
                    <ComboBox x:Name="TargetLangCombo" Width="170" Height="28" VerticalContentAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock x:Name="DetectedLangText" Text="" VerticalAlignment="Center" Foreground="#007ACC" FontWeight="SemiBold" />
                </StackPanel>

                <TextBox Grid.Row="1" x:Name="InputBox"
                         AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         FontSize="13.5" Padding="6"
                         KeyDown="InputBox_KeyDown" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
                    <Button x:Name="TranslateButton" Content="执行翻译 (Ctrl+Enter)" Width="160" Height="30" FontWeight="Bold" IsEnabled="False" Click="TranslateButton_Click" />
                    <Button x:Name="CancelTranslateButton" Content="停止" Width="68" Height="30" Margin="8,0,0,0" IsEnabled="False" Click="CancelTranslateButton_Click" />
                    <Button x:Name="ClearButton" Content="清空" Width="68" Height="30" Margin="8,0,0,0" Click="ClearButton_Click" />
                    <Button x:Name="CopyOutputButton" Content="复制译文" Width="84" Height="30" Margin="8,0,0,0" Click="CopyOutputButton_Click" />
                    <TextBlock x:Name="LatencyText" Text="耗时: -- ms" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#006600" FontWeight="SemiBold" />
                </StackPanel>

                <TextBox Grid.Row="3" x:Name="OutputBox"
                         IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         FontSize="13.5" Padding="6"
                         Background="#F9FBFD" />
            </Grid>
        </GroupBox>

        <!-- ======================= 日志面板 ======================= -->
        <GroupBox Grid.Row="3" Header="运行日志" Padding="4" Height="145" Margin="0,8,0,0">
            <TextBox x:Name="LogBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5" />
        </GroupBox>
    </Grid>
</Window>
